% NVIDIA-light Beamer theme derived from NVIDIA_PPT_Light_External_v2.potx.
% This is a visual adaptation for LaTeX; it is not an official NVIDIA template.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemenvidialight}[2026/07/29 NVIDIA light presentation theme]

\RequirePackage{fontspec}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{ragged2e}
\RequirePackage{amsmath}
\RequirePackage{listings}

\mode<presentation>

% Palette extracted from the supplied NVIDIA PowerPoint theme.
\definecolor{NvidiaGreen}{HTML}{76B900}
\definecolor{NvidiaTeal}{HTML}{1DBBA4}
\definecolor{NvidiaBlue}{HTML}{0074DF}
\definecolor{NvidiaPurple}{HTML}{952FC6}
\definecolor{NvidiaOrange}{HTML}{EF9100}
\definecolor{NvidiaBlack}{HTML}{000000}
\definecolor{NvidiaCharcoal}{HTML}{313131}
\definecolor{NvidiaGray}{HTML}{757575}
\definecolor{NvidiaLightGray}{HTML}{F7F7F7}
\definecolor{NvidiaRuleGray}{HTML}{D9D9D9}

% Use the supplied managed NVIDIA Sans files when available; retain a portable fallback.
\IfFileExists{/Library/Fonts/Managed/NVIDIASans-Regular_1357495649.ttf}{
  \setsansfont{NVIDIASans-Regular_1357495649}[
    Path=/Library/Fonts/Managed/,
    Extension=.ttf,
    BoldFont=NVIDIASans-Bold_3059767565,
    ItalicFont=NVIDIASans-Italic_1086104804,
    BoldItalicFont=NVIDIASans-BoldItalic_4041623657
  ]
  \newfontfamily\NvidiaSansMedium{NVIDIASans-Medium_4255550447}[
    Path=/Library/Fonts/Managed/,
    Extension=.ttf
  ]
}{
  \IfFontExistsTF{NVIDIA Sans}{
    \setsansfont{NVIDIA Sans}
    \newfontfamily\NvidiaSansMedium{NVIDIA Sans Medium}
  }{
    \setsansfont{Helvetica Neue}
    \newfontfamily\NvidiaSansMedium{Helvetica Neue}
  }
}
\renewcommand{\familydefault}{\sfdefault}

\setbeamersize{text margin left=0.38in,text margin right=0.38in}
\setlength{\parskip}{0.30em}
\setlength{\tabcolsep}{0.55em}
\renewcommand{\arraystretch}{1.18}

\setbeamercolor{normal text}{fg=NvidiaCharcoal,bg=white}
\setbeamercolor{structure}{fg=NvidiaGreen}
\setbeamercolor{title}{fg=NvidiaBlack}
\setbeamercolor{subtitle}{fg=NvidiaCharcoal}
\setbeamercolor{frametitle}{fg=NvidiaBlack,bg=white}
\setbeamercolor{framesubtitle}{fg=NvidiaCharcoal,bg=white}
\setbeamercolor{footline}{fg=NvidiaGray,bg=white}
\setbeamercolor{alerted text}{fg=NvidiaGreen}
\setbeamercolor{block title}{fg=NvidiaBlack,bg=NvidiaLightGray}
\setbeamercolor{block body}{fg=NvidiaCharcoal,bg=NvidiaLightGray}
\setbeamercolor{itemize item}{fg=NvidiaGreen}
\setbeamercolor{itemize subitem}{fg=NvidiaGreen}
\setbeamercolor{enumerate item}{fg=NvidiaGreen}

\setbeamerfont{title}{family=\NvidiaSansMedium,series=\mdseries,size=\fontsize{27}{31}}
\setbeamerfont{subtitle}{size=\fontsize{14}{18}}
\setbeamerfont{frametitle}{family=\NvidiaSansMedium,series=\mdseries,size=\fontsize{18.5}{21.5}}
\setbeamerfont{framesubtitle}{size=\fontsize{10}{12}}
\setbeamerfont{normal text}{size=\fontsize{10.5}{13}}
\setbeamerfont{footline}{size=\fontsize{7.5}{9}}
\setbeamerfont{author}{size=\fontsize{10}{13}}
\setbeamerfont{date}{size=\fontsize{9}{12}}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{itemize subitem}{\raise0.2ex\hbox{\tiny\textcolor{NvidiaGreen}{\textbullet}}}
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{sections/subsections in toc}[square]
\setbeamertemplate{blocks}[rounded][shadow=false]

\newcommand{\NvidiaFooterText}{}
\newcommand{\NvidiaSetFooter}[1]{\renewcommand{\NvidiaFooterText}{#1}}
\newif\ifNvidiaShowPageNumber
\NvidiaShowPageNumberfalse
\newcommand{\NvidiaShowPageNumbers}{\NvidiaShowPageNumbertrue}
\newcommand{\NvidiaHidePageNumbers}{\NvidiaShowPageNumberfalse}
\newcommand{\NvidiaSource}[1]{\gdef\insertNvidiaSource{#1}}
\newcommand{\insertNvidiaSource}{}
\newcommand{\NvidiaResetSource}{\gdef\insertNvidiaSource{}}
\newcommand{\NvidiaWordmark}{\includegraphics[height=.18in]{assets/nvidia-footer-logo.png}}

\setbeamertemplate{frametitle}{%
  \vspace*{0.18in}%
  \nointerlineskip\strut\insertframetitle\par
  \ifblank{\insertframesubtitle}{}{\vspace*{0.04in}{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}}%
  \vspace*{0.11in}%
}

\setbeamertemplate{footline}{%
  \leavevmode\hbox{%
    % Keep the section label on the same .38in grid as frame titles; the page
    % number occupies only the otherwise empty gutter to its left.
    \begin{beamercolorbox}[wd=.38in,ht=0.18in,dp=0.08in,leftskip=.14in]{footline}%
      \ifNvidiaShowPageNumber\insertframenumber\fi
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=\dimexpr\paperwidth-1.94in\relax,ht=0.18in,dp=0.08in]{footline}%
      \NvidiaFooterText\ifblank{\insertsectionhead}{}{\hspace{.45em}-\hspace{.45em}\insertsectionhead}%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=1.56in,ht=0.18in,dp=0.08in,rightskip=.14in plus1fil]{footline}%
      \hfill\NvidiaWordmark
    \end{beamercolorbox}%
  }%
  \NvidiaResetSource
}

\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=center,inner sep=0] at (current page.center) {\includegraphics[width=\paperwidth,height=\paperheight]{assets/nvidia-cover-background.jpg}};
    \node[anchor=north west,inner sep=0] at ([xshift=.27in,yshift=-.38in]current page.north west) {\includegraphics[width=1.31in]{assets/nvidia-cover-logo.png}};
    \node[anchor=north west,text=NvidiaBlack,align=left,text width=.55\paperwidth] (nvidia-title)
      at ([xshift=.38in,yshift=-1.62in]current page.north west) {\usebeamerfont{title}\inserttitle};
    \node[anchor=north west,text=NvidiaCharcoal,align=left,text width=.54\paperwidth]
      at ([yshift=-.18in]nvidia-title.south west) {\usebeamerfont{subtitle}\insertsubtitle};
    \node[anchor=south west,text=NvidiaCharcoal,align=left,text width=.47\paperwidth]
      at ([xshift=.38in,yshift=.30in]current page.south west) {\usebeamerfont{author}\insertauthor};
    \node[anchor=south west,text=NvidiaGray,align=left,text width=.47\paperwidth]
      at ([xshift=.38in,yshift=.10in]current page.south west) {\usebeamerfont{date}\insertdate};
  \end{tikzpicture}%
  \mbox{}%
}

% Template-derived transition layout.
\newcommand{\NvidiaTransitionSlide}[2]{%
  \begin{frame}[plain]
    \hypertarget{#1}{}
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=center,inner sep=0] at (current page.center) {\includegraphics[width=\paperwidth,height=\paperheight]{assets/nvidia-transition-background.jpg}};
      \node[anchor=north west,text=NvidiaBlack,text width=.56\paperwidth,align=left]
        at ([xshift=3.05in,yshift=-.20in]current page.north west) {\raggedright\hyphenpenalty=10000\NvidiaSansMedium\fontsize{21}{24}\selectfont #2};
    \end{tikzpicture}
  \end{frame}%
}

% A compact metric for causal claims and benchmark results.
\newcommand{\NvidiaMetric}[3]{%
  \begin{minipage}[t]{.29\textwidth}\raggedright
    {\NvidiaSansMedium\fontsize{20}{24}\selectfont\color{NvidiaBlack}#1}\par
    {\fontsize{8.5}{11}\selectfont\color{NvidiaCharcoal}#2}\par
    {\fontsize{8}{10}\selectfont\color{NvidiaGray}#3}
  \end{minipage}%
}

% Neutral evidence block for explanatory annotations.
\newenvironment{NvidiaEvidence}[1]{%
  \par\vspace{.06in}\noindent{\NvidiaSansMedium\color{NvidiaGreen}\normalsize #1}\par\vspace{.03in}\small\justifying
}{}

% Compact heading-to-rule treatment for explanatory blocks.
\newcommand{\NvidiaTightRule}[2][\linewidth]{%
  \par\vspace{-.06in}{\color{NvidiaGreen}\rule{#1}{#2}}\par
}

\newenvironment{NvidiaCard}[1]{%
  \begin{beamercolorbox}[rounded=true,sep=.12in,wd=\linewidth]{block body}%
    {\NvidiaSansMedium\color{NvidiaBlack}#1}\par\vspace{.04in}\small
}{%
  \end{beamercolorbox}%
}

% Source skeletons and algorithm pseudocode use distinct, deliberately compact
% lexers.  This preserves CUDA semantics without coloring pseudocode as C++.
\lstdefinelanguage{NvidiaCUDA}[]{C++}{
  morekeywords=[1]{__device__,__global__,__host__,__shared__,__forceinline__,__launch_bounds__,
    constexpr,decltype,static_cast,auto,typename,template},
  morekeywords=[2]{__syncthreads,__syncwarp,__shfl_sync,__shfl_xor_sync,__ballot_sync,__ffs,__popc},
  keywordstyle=[1]\color{NvidiaBlue},
  keywordstyle=[2]\color{NvidiaPurple}
}
\lstdefinelanguage{NvidiaPseudo}{
  morekeywords={for,in,range,if,else,elif,while,and,or,not,until,select,validate,return,break,continue},
  morekeywords=[2]{route,dispatch,grouped_mlp,combine,cuda_graph,router,send,router_backward,time,
    verify_correctness,owner_rank,process_active_expert,fused_router,hybrid_ep,compatibility_bool_route},
  keywordstyle=\color{NvidiaBlue},
  keywordstyle=[2]\color{NvidiaPurple},
  sensitive=true,
  morecomment=[l]{\#},
  morestring=[b]"
}
\lstdefinestyle{nvidiacode}{
  basicstyle=\ttfamily\fontsize{8.5}{10.5}\selectfont,
  backgroundcolor=\color{NvidiaLightGray},
  frame=single,
  rulecolor=\color{NvidiaRuleGray},
  framesep=6pt,
  xleftmargin=4pt,
  xrightmargin=4pt,
  aboveskip=4pt,
  belowskip=4pt,
  showstringspaces=false,
  columns=fullflexible,
  breaklines=true,
  breakatwhitespace=false,
  keepspaces=true,
  numberstyle=\color{NvidiaGray},
  keywordstyle=\color{NvidiaBlue},
  commentstyle=\color{NvidiaGray},
  stringstyle=\color{NvidiaPurple}
}
\lstnewenvironment{NvidiaCode}[1][]{\lstset{style=nvidiacode,language=NvidiaPseudo,#1}}{}

% A light progression borrowed from the template's horizontal progression page.
% Use it for a single directional story; prefer a real diagram for branching logic.
\newenvironment{NvidiaProgression}{%
  \begin{tikzpicture}[x=\textwidth,y=1in,baseline=(current bounding box.center)]
    \draw[-{Latex[length=2.2mm]},line width=1.0pt,NvidiaGreen] (.003,0) -- (.994,0);%
}{%
  \end{tikzpicture}%
}

\newcommand{\NvidiaProgressionStep}[4]{%
  \draw[line width=.8pt,NvidiaGreen] (#1,0) -- (#1,.25);%
  \fill[NvidiaGreen] (#1,0) circle[radius=2.35pt];%
  \node[anchor=south,text width=.20\textwidth,align=left,text=NvidiaBlack]
    at (#1,.38) {\NvidiaSansMedium\fontsize{11}{13}\selectfont #2\par
      {\fontsize{8}{10}\selectfont\color{NvidiaGray}#3}};%
  \node[anchor=north,text width=.20\textwidth,align=left,text=NvidiaCharcoal]
    at (#1,-.20) {\fontsize{8.5}{11}\selectfont #4};%
}

% Image layouts derived from the template's one-up and text-plus-image pages.
% Supply images that match the intended slot ratio so they remain uncropped.
\newcommand{\NvidiaImageCaption}[1]{%
  {\fontsize{7.5}{9}\selectfont\color{NvidiaGray}\raggedright #1\par}%
}

\newcommand{\NvidiaImageLayoutFooter}[1]{%
  \node[anchor=south east,inner sep=0] at ([xshift=-.38in,yshift=.20in]current page.south east) {\NvidiaWordmark};%
  \ifblank{#1}{}{\node[anchor=south west,text=NvidiaGray,align=left,text width=4.7in]
    at ([xshift=.38in,yshift=.20in]current page.south west) {\usebeamerfont{footline}#1};}%
}

\newcommand{\NvidiaTextImageLayout}[6]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=north west,text=NvidiaBlack,text width=#4] (nvidia-image-title)
        at ([xshift=.38in,yshift=-.30in]current page.north west)
        {\raggedright\usebeamerfont{frametitle}\hyphenpenalty=10000\exhyphenpenalty=10000\emergencystretch=3em\strut #1\par};
      \node[anchor=north west,text=NvidiaCharcoal,text width=#4] (nvidia-image-subtitle)
        at ([yshift=-.06in]nvidia-image-title.south west)
        {\raggedright\usebeamerfont{framesubtitle}\strut #2\par};
      \node[anchor=north east,inner sep=0]
        at ([xshift=-.38in,yshift=-.30in]current page.north east)
        {\includegraphics[width=#5,height=#6]{#3}};
      \node[anchor=north west,inner sep=0,text=NvidiaCharcoal,align=left,text width=#4]
        at ([yshift=-.32in]nvidia-image-subtitle.south west)
        {\begin{minipage}[t]{#4}\raggedright\usebeamerfont{normal text}\strut\insertNvidiaImageCopy\end{minipage}};
      \NvidiaImageLayoutFooter{\insertNvidiaImageSource}
    \end{tikzpicture}
  \end{frame}%
}

\newcommand{\NvidiaTextImageFrame}[5]{%
  \gdef\insertNvidiaImageSource{#4}%
  \gdef\insertNvidiaImageCopy{#5}%
  \NvidiaTextImageLayout{#1}{#2}{#3}{2.86in}{2.15in}{2.15in}%
}

\newcommand{\NvidiaPortraitImageFrame}[5]{%
  \gdef\insertNvidiaImageSource{#4}%
  \gdef\insertNvidiaImageCopy{#5}%
  \NvidiaTextImageLayout{#1}{#2}{#3}{3.45in}{1.78in}{2.23in}%
}

% Backward-compatible alias. Prefer \NvidiaPortraitImageFrame in new decks.
\newcommand{\NvidiaImageTextFrame}[5]{\NvidiaPortraitImageFrame{#1}{#2}{#3}{#4}{#5}}

\newcommand{\NvidiaWideImageFrame}[5]{%
  \begin{frame}{#1}{#2}
    \NvidiaSource{#4}%
    \centering\vspace*{.02in}%
    \includegraphics[width=.82\textwidth,height=1.87in,keepaspectratio]{#3}\par
    \vspace*{.04in}\begin{minipage}{.78\textwidth}\NvidiaImageCaption{#5}\end{minipage}
  \end{frame}%
}

\mode<all>
